<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>
    ROS 2 launch files for standalone simulation, SLAM Toolbox simulation mapping,
    and Nav2 simulation navigation. A final physical-hardware launch profile is still pending.
  </description>
  <maintainer email="team@example.invalid">LiDAR Robot Team</maintainer>
  <license>TODO: team to choose a license</license>


  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>robot_base_bridge</exec_depend>
  <exec_depend>robot_mock</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
